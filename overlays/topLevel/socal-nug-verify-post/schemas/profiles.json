{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User Profile Wrapper",
    "description": "A wrapper object containing a user profile.",
    "type": "object",
    "properties": {
        "weight": {
            "type": "integer",
            "description": "Position on the about page; lower numbers come first."
        },
        "extra": {
            "type": "object",
            "properties": {
                "member": {
                    "type": "boolean",
                    "description": "True for members of the group, who appear on the about page. False for guests, who appear only in the Origins braid."
                },
                "name": {
                    "type": "string",
                    "description": "The full name of the user."
                },
                "alias": {
                    "type": "string",
                    "description": "The user's alias or username."
                },
                "description": {
                    "type": "string",
                    "description": "A brief description of the user, including affiliations and interests."
                },
                "image_url": {
                    "type": "string",
                    "description": "The URL to the user's profile image.",
                    "format": "uri"
                },
                "profile_url": {
                    "type": "string",
                    "description": "The URL to the user's profile.",
                    "format": "uri"
                }
            },
            "required": [
                "member",
                "name",
                "alias"
            ],
            "if": {
                "properties": {
                    "member": {
                        "const": true
                    }
                },
                "required": [
                    "member"
                ]
            },
            "then": {
                "required": [
                    "description",
                    "image_url",
                    "profile_url"
                ]
            },
            "description": "The user profile information. Members must also carry a description, image and profile URL; guests may omit them."
        }
    },
    "required": [
        "extra"
    ]
}
